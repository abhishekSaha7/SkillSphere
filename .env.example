# Database Connection (Supabase PostgreSQL / Standard PostgreSQL)
# For Supabase PostgreSQL with Transaction Pooler & Direct Connection:
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgboiler=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth secret and configuration
NEXTAUTH_SECRET="skillsphere-super-secret-key-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"

# Storage Service Provider (MOCK, SUPABASE, CLOUDINARY, S3)
STORAGE_PROVIDER="MOCK"

# Payment Service Provider (MOCK, STRIPE, RAZORPAY)
PAYMENT_PROVIDER="MOCK"

# Video Service Provider (MOCK, YOUTUBE, VIMEO)
VIDEO_PROVIDER="MOCK"
