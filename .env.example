# Environment variables example for SkillSphere
# Duplicate this file to .env for local development

# Database connection
# For SQLite (local zero-config development):
DATABASE_URL="file:./dev.db"

# NextAuth secret and configuration
NEXTAUTH_SECRET="skillsphere-super-secret-key-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"

# Storage Service Mode (MOCK, CLOUDINARY, S3)
STORAGE_PROVIDER="MOCK"

# Payment Service Mode (MOCK, STRIPE, RAZORPAY)
PAYMENT_PROVIDER="MOCK"

# Video Service Mode (MOCK, YOUTUBE, VIMEO)
VIDEO_PROVIDER="MOCK"
